{
  "name": "pouch-villa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @pv/frontend dev",
    "build": "pnpm --filter @pv/frontend build",
    "start": "pnpm --filter @pv/frontend start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:routes": "pnpm --filter @pv/frontend test:routes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm --filter @pv/backend setup",
    "db:seed": "pnpm --filter @pv/backend db:seed",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:routes"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5"
  }
}
