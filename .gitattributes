# Normalise line endings in the repository; check out native on Windows.
* text=auto

# Always LF in the working tree — these break if a shell or tool sees CRLF.
*.sh          text eol=lf
*.mjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sql         text eol=lf
*.css         text eol=lf
*.md          text eol=lf

# Binary. Never diff, never touch line endings, never merge.
*.pdf         binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.avif        binary
*.gif         binary
*.ico         binary
*.mp4         binary
*.webm        binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary

# Generated — collapse in review, exclude from language stats.
pnpm-lock.yaml   -diff linguist-generated
package-lock.json -diff linguist-generated
