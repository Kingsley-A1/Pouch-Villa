# Local SQLite path. Sites preview should use /tmp/pouch-villa-prototype.db.
DATABASE_URL=data/pouch-villa-prototype.db

# Generated by npm run setup. Replace for every production environment.
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Demonstration administrator created by npm run setup.
DEMO_ADMIN_EMAIL=admin@pouchvilla.demo
DEMO_ADMIN_PASSWORD=change-me-during-setup

# Leave blank until Pouch Villa supplies and approves its official WhatsApp number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional approved business details. Blank values render as awaiting confirmation.
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_HOURS=
