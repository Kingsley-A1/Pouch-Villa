# ---------------------------------------------------------------------------
# Infrastructure, plus a small set of first-run seeds.
#
# Business facts live in the admin settings store — that is the source of truth.
# The SEED_* variables below exist only to populate a setting that has no value
# yet. Once a staff member edits that setting in the admin, the row is marked as
# admin-owned and the seed stops applying to it, permanently. A redeploy can
# therefore never overwrite what someone configured on a Sunday.
#
# See packages/pv-backend/src/services/settings.ts and AGENTS.md §4.
# ---------------------------------------------------------------------------

# CockroachDB connection string. There is no fallback: an unset or unreachable
# value fails at the boundary rather than serving a store that discards writes.
DATABASE_URL=
DATABASE_POOL_MAX=10

# Session signing key. Minimum 32 characters, from a real secret source.
AUTH_SECRET=

# Absolute origin for canonical URLs, sitemap entries and link previews.
NEXT_PUBLIC_SITE_URL=pouchvilla.com.ng

# Search indexing is opt-in. "true" only on the live production host.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Google OAuth. Used by customers and staff alike; it authenticates only and
# never grants a role — a staff account still requires a redeemed role code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Server-only providers. Leave values blank until the corresponding provider
# resources have been created. These must never be exposed through NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# Cloudflare R2 S3-compatible endpoint and scoped credentials. Keep product
# media and payment proofs in different buckets; the latter stays private.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=

# Public CDN or custom-domain origin for public product media only. Do not point
# this at the private payment-proof bucket.
R2_PUBLIC_BASE_URL=

# Resend API credential.
RESEND_API_KEY=

# Sending identity. This is infrastructure — the address must belong to a domain
# verified with Resend, so it is not something an admin can change at will. The
# customer-facing contact address is a separate, admin-managed business setting.
RESEND_EMAIL_SEND_FROM=
RESEND_EMAIL_SEND_FROM_NAME=

# Where operational alerts go when there is no per-order recipient.
RESEND_EMAIL_SEND_TO=

# ---------------------------------------------------------------------------
# First-run seeds. Admin-editable afterwards; see the note at the top.
# ---------------------------------------------------------------------------

# Bank details shown at checkout for "Pay by Transfer".
SEED_BANK_ACCOUNT_NAME=
SEED_BANK_ACCOUNT_NUMBER=
SEED_BANK_NAME=

# Optional. Pre-authorises one email address to redeem the bootstrap CEO code,
# so the code alone is not sufficient if it is seen in a terminal or a log.
# Leave blank to allow any address to redeem it.
BOOTSTRAP_CEO_EMAIL=
