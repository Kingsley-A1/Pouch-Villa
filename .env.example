# ---------------------------------------------------------------------------
# Infrastructure only.
#
# Business facts — phone numbers, addresses, opening hours, bank details, prices,
# delivery fees, policy wording — never belong here. They live in the admin
# settings store so a staff member can change them on a Sunday without a
# deployment. See AGENTS.md §4.
# ---------------------------------------------------------------------------

# Inherited prototype SQLite path. Replaced by a CockroachDB connection string in
# Phase 0; the prototype driver is not durable on a serverless host.
DATABASE_URL=data/pouch-villa-prototype.db

# Session signing key. Minimum 32 characters, from a real secret source.
# There is no fallback: an unconfigured production environment fails to start
# rather than signing sessions with a guessable value.
AUTH_SECRET=

# Absolute origin used for canonical URLs, sitemap entries and link previews.
NEXT_PUBLIC_SITE_URL=

# Search indexing is opt-in. Leave unset or "false" on every staging, preview and
# development environment; set to "true" only on the live production host.
NEXT_PUBLIC_SITE_INDEXABLE=false
