{
  "name": "@pv/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./auth/*": "./src/auth/*.ts",
    "./db/*": "./src/db/*.ts",
    "./services/*": "./src/services/*.ts",
    "./storage/*": "./src/storage/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "node --import tsx scripts/setup.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "claim-code": "node --import tsx scripts/claim-code.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "bcryptjs": "^3.0.3",
    "hash-wasm": "^4.12.0",
    "jose": "^6.2.3",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
